# Przykładowa konfiguracja środowiska (NIE wstawiać sekretów do repo)
# Skopiuj do pliku `.env` i uzupełnij wartości.

# Połączenie do bazy (PostgreSQL w formacie URL)
# Przykład lokalny:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/donkeybackend
DATABASE_URL=

# Klucz podpisujacy JWT i sesje. Wygeneruj losowy, min. 50 znakow:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Bez niego backend uzywa fallbacku deweloperskiego (nie uzywac na produkcji!).
SECRET_KEY=

# Klucz do usług zewnętrznych (opcjonalnie; wymagane tylko dla funkcji AI)
OPENAI_API_KEY=

# --- HTTPS / ciasteczka (wlaczaj dopiero, gdy Nginx przekazuje X-Forwarded-Proto) ---
# 1/true/yes => SECURE_SSL_REDIRECT, SESSION_COOKIE_SECURE, CSRF_COOKIE_SECURE, HSTS
DJANGO_SECURE_SSL=False
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=False

# --- tryb testowy JWT (WYLACZNIE dev, nigdy produkcja) ---
# Flaga ułatwiająca testy/autoryzację w środowisku deweloperskim
TEST_TOKEN_ENABLED=False
# TEST_TOKEN_VALUE=test
# TEST_TOKEN_USER_ID=
# TEST_TOKEN_USER_EMAIL=

# --- strojenie solvera (JSON, opcjonalne; patrz donkeybackend/CLAUDE.md) ---
# SOLVER_OPTIONS_JSON={"no_split_shifts": false}
